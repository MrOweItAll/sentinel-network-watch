[Unit]
Description=Sentinel autonomous local review hub
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/sentinel-hub/config.json
ConditionPathExists=/etc/sentinel-hub/dashboard-auth.json
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/sentinel-network-watch hub serve --config /etc/sentinel-hub/config.json
WorkingDirectory=/
UMask=0077
StateDirectory=sentinel-hub
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
ProtectSystem=strict
ProtectHome=read-only
ProtectProc=default
ProcSubset=all
ReadWritePaths=/var/lib/sentinel-hub
ReadOnlyPaths=-/var/lib/sentinel-router -/etc/sentinel-alerts
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
