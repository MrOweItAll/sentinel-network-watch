[Unit]
Description=Sentinel hub liveness and durable alert retry
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/sentinel-hub/config.json

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/sentinel-network-watch hub watchdog --config /etc/sentinel-hub/config.json
UMask=0077
TimeoutStartSec=90
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/sentinel-hub
StandardOutput=null
StandardError=null
