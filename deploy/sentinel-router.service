[Unit]
Description=Sentinel optional read-only router observations and alert handoff
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/sentinel-network-watch router collect
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
StateDirectory=sentinel-router sentinel-alerts
StateDirectoryMode=0700
TimeoutStartSec=100
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/sentinel-router /var/lib/sentinel-alerts
