[Unit]
Description=Sentinel bounded local observation handoff
After=network-online.target

[Service]
Type=oneshot
User=root
Group=sentinelconsole
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/sentinel-console
ExecStart=/usr/bin/python3 -m sentinel_watch.console_feed --config /etc/sentinel-console-feed/config.json
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/sentinel-console-feed
ReadOnlyPaths=/var/lib/sentinel-router
InaccessiblePaths=/root /var/lib/sentinel-alerts -/etc/sentinel-alerts -/etc/sentinel-router -/etc/sentinel
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
MemoryMax=192M
TasksMax=8
TimeoutStartSec=25

